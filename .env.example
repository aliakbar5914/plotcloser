# Copy this file to backend/.env and fill in real values.
# NEVER commit the real .env file.

# Claude API key (from your group's workspace email)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model required by the workshop
MODEL_NAME=claude-haiku-5-5

# Neon Postgres connection string (Neon dashboard -> Connect)
DATABASE_URL=postgresql://user:password@your-host.neon.tech/neondb?sslmode=require

# Password for the admin dashboard API
ADMIN_PASSWORD=change-me

# Website URL allowed to call the API (CORS). Use * while developing.
ALLOWED_ORIGINS=*
